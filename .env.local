# Storage Configuration
STORAGE_MODE=local
# Options: local, s3, sftp, ftp, webdav

# S3 Configuration (if using S3 storage)
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket_name
S3_REGION=us-east-1

# SFTP Configuration (if using SFTP storage)
SFTP_HOST=your_sftp_host
SFTP_USER=your_sftp_username
SFTP_PASSWORD=your_sftp_password
SFTP_PORT=22

# FTP Configuration (if using FTP storage)
FTP_HOST=your_ftp_host
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_PORT=21

# WebDAV Configuration (if using WebDAV storage)
WEBDAV_URL=your_webdav_url
WEBDAV_USERNAME=your_webdav_username
WEBDAV_PASSWORD=your_webdav_password

# SSH Terminal Configuration
SSH_REMOTE_MODE=false
# Set to true if you want remote SSH with provided credentials
SSH_HOST=your_ssh_host
SSH_USERNAME=your_ssh_username
SSH_PASSWORD=your_ssh_password
SSH_PORT=22

# WebSocket Server Configuration
WS_PORT=3001
