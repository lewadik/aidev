# General
# PORT is read by Next.js in production. Default 3000
PORT=3000

# WebSocket server port (used by src/lib/sshTerminalServer.ts)
WS_PORT=3001

# Terminal mode: set to true to use remote SSH via ssh2
SSH_REMOTE_MODE=false
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USERNAME=your_user
SSH_PASSWORD=your_password

# Public config for the browser to connect to the WebSocket server.
# If unset, the client will use ws(s)://<host>/ws
# Example for separate port without reverse proxy:
# NEXT_PUBLIC_WS_URL=ws://your-domain.com:3001
# Or if using a reverse proxy path, you can change the path (default /ws):
# NEXT_PUBLIC_WS_PATH=/ws

# Storage mode (future use): local|s3|sftp|ftp|webdav
STORAGE_MODE=local

# S3 example (if you enable S3 in APIs)
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket_name
