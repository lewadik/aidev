# General
# PORT is read by Next.js in production. Default 3000
PORT=3000

# WebSocket server port (used by src/lib/sshTerminalServer.ts)
WS_PORT=3001

# Terminal mode: set to true to use remote SSH via ssh2
SSH_REMOTE_MODE=false
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USERNAME=your_user
SSH_PASSWORD=your_password

# Public config for the browser to connect to the WebSocket server.
# If unset, the client will use ws(s)://<host>/ws
# Example for separate port without reverse proxy:
# NEXT_PUBLIC_WS_URL=ws://your-domain.com:3001
# Or if using a reverse proxy path, you can change the path (default /ws):
# NEXT_PUBLIC_WS_PATH=/ws

# Storage Configuration
# Supported modes: local|s3|sftp|ftp|webdav
STORAGE_MODE=local

# Local Storage (default)
LOCAL_UPLOAD_PATH=uploads

# S3 Storage Configuration
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1
S3_BUCKET=your_bucket_name
# S3_ENDPOINT=https://s3.amazonaws.com  # Optional: for S3-compatible services

# SFTP Storage Configuration
SFTP_HOST=your_sftp_host
SFTP_PORT=22
SFTP_USERNAME=your_username
SFTP_PASSWORD=your_password
# SFTP_PRIVATE_KEY=path/to/private/key  # Alternative to password
SFTP_REMOTE_PATH=/uploads

# FTP Storage Configuration (requires basic-ftp package)
FTP_HOST=your_ftp_host
FTP_PORT=21
FTP_USERNAME=your_username
FTP_PASSWORD=your_password
FTP_SECURE=false  # Set to true for FTPS
FTP_REMOTE_PATH=/uploads

# WebDAV Storage Configuration
WEBDAV_URL=https://your-webdav-server.com
WEBDAV_USERNAME=your_username
WEBDAV_PASSWORD=your_password
WEBDAV_REMOTE_PATH=/uploads
